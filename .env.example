# ==== App (Expo) — somente valores PÚBLICOS. Copie para .env e preencha. ====
# URL e chave anon (pública) do projeto Supabase. Sem elas o app roda em modo local/demonstração.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# ID do projeto EAS (necessário só para token de notificações push remotas).
EXPO_PUBLIC_EAS_PROJECT_ID=

# ==== Edge Functions — SEGREDOS. Nunca coloque no app nem no repositório. ====
# Defina com: npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem nas funções hospedadas.)
ANTHROPIC_API_KEY=
# Modelo do assistente (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_DAILY_LIMIT=100

# Transcrição de voz: endpoint compatível com /v1/audio/transcriptions (OpenAI, Groq...)
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_DAILY_LIMIT=60

# Google Calendar (cliente OAuth do tipo "Aplicativo da Web" no Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios em base64 (ex.: openssl rand -base64 32) para cifrar tokens
TOKEN_ENCRYPTION_KEY=
# Segredo para assinar o "state" do OAuth (ex.: openssl rand -hex 32)
OAUTH_STATE_SECRET=
# Retornos permitidos após o OAuth, além de northline:// e exp:// (separe por vírgula)
ALLOWED_RETURN_URLS=http://localhost:8081/
# Origens permitidas (CORS) para a versão web
ALLOWED_ORIGINS=*
